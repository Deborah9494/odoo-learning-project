<odoo>

    <!-- Step 3 — prevent the Public User from writing properties. -->
    <record id="rule_real_estate_property_public_no_write" model="ir.rule">
        <field name="name">Property: public user cannot write</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="domain_force">[('id', '=', False)]</field>
        <field name="perm_read">False</field>
        <field name="perm_write">True</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

    <!-- Step 4 — allow the Public User to read only published properties. -->
    <record id="rule_real_estate_property_public_read" model="ir.rule">
        <field name="name">Property: public user can read published properties</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="domain_force">[('x_api_published', '=', True)]</field>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

</odoo>