<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Extend standard res.partner model to link back to Properties -->
    <record id="field_res_partner_property_ids" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="name">x_property_ids</field>
        <field name="field_description">Properties</field>
        <field name="ttype">one2many</field>
        <field name="relation">x_estate.property</field>
        <field name="relation_field">x_partner_id</field>
    </record>

    <!-- 2. Server Action: Auto-set Date Availability to +3 Months if empty on creation/update -->
    <record id="action_set_default_availability_date" model="ir.actions.server">
        <field name="name">Set Default Availability Date</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for record in records:
    if not record.x_date_availability:
        record['x_date_availability'] = datetime.date.today() + datetime.timedelta(days=90)
        ]]></field>
    </record>

    <!-- Automated Action (Base Automation) to invoke the default date logic upon record creation -->
    <record id="rule_set_default_availability_date" model="base.automation">
        <field name="name">Auto Set Availability Date</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="trigger">on_create</field>
        <field name="action_server_ids" eval="[(4, ref('action_set_default_availability_date'))]"/>
    </record>

    <!-- 3. Server Action to toggle the API publication status of Properties -->
    <record id="action_estate_property_toggle_published" model="ir.actions.server">
        <field name="name">Toggle API Published</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_real_estate_property"/>
        <field name="binding_view_types">tree,form</field>
        <field name="code"><![CDATA[
for record in records:
    record['x_api_published'] = not record.x_api_published
        ]]></field>
    </record>

</odoo>