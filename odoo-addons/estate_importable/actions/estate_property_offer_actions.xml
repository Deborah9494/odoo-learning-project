<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Accept offer -->
    <record id="action_x_estate_property_offer_accept" model="ir.actions.server">
        <field name="name">Accept offer</field>
        <field name="model_id" ref="model_real_estate_property_offer"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_real_estate_property_offer"/>
        <field name="binding_view_types">tree,form</field>
        <field name="code"><![CDATA[
for offer in records:
    property = offer.x_property_id
    property.x_offer_ids.write({'x_status': 'refused'})
    offer.write({'x_status': 'accepted'})
    property.write({
        'x_selling_price': offer.x_price,
        'x_partner_id': offer.x_partner_id.id,
    })
        ]]></field>
    </record>
    <!-- Refuse offer -->
    <record id="action_x_estate_property_offer_refuse" model="ir.actions.server">
        <field name="name">Refuse offer</field>
        <field name="model_id" ref="model_real_estate_property_offer"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="model_real_estate_property_offer"/>
        <field name="binding_view_types">tree,form</field>
        <field name="code"><![CDATA[
for offer in records:
    offer.write({'x_status': 'refused'})
        ]]></field>
    </record>
</odoo>