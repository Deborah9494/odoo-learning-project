<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action -->
    <record id="action_real_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">x_estate.property</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tree view -->
    <record id="view_real_estate_property_tree" model="ir.ui.view">
        <field name="name">x_estate.property.tree</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <tree>
                <field name="x_name"/>
                <field name="x_expected_price"/>
                <field name="x_selling_price"/>
                <field name="x_bedrooms"/>
                <field name="x_living_area"/>
                <field name="x_garden"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_real_estate_property_form" model="ir.ui.view">
        <field name="name">x_estate.property.form</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1> 
                        <field name="x_name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="x_property_type_id"/>
                            <field name="x_property_tag_ids"/>
                            <field name="x_postcode"/>
                            <field name="x_date_availability"/>
                            <field name="x_user_id"/>
                        </group>
                        <group>
                            <field name="x_expected_price"/>
                            <field name="x_selling_price"/>
                            <field name="x_partner_id"/>
                            <field name="x_country_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="x_description"/>
                                <field name="x_bedrooms"/>
                                <field name="x_living_area"/>
                                <field name="x_facades"/>
                                <field name="x_garage"/>
                                <field name="x_garden"/>
                                <field name="x_garden_area"/>
                                <field name="x_garden_orientation"/>
                                <field name="x_total_area"/>
                            </group>
                        </page>

                        <page string="Offers">
                            <field name="x_offer_ids"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_real_estate_property"
        name="Properties"
        action="action_real_estate_property"
    />

</odoo>