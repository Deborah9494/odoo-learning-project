<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_real_estate_property_offer_tree" model="ir.ui.view">
        <field name="name">x_estate.property.offer.tree</field>
        <field name="model">x_estate.property.offer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="x_price"/>
                <field name="x_partner_id"/>
                <field name="x_status"/>
                <button
                    name="estate_importable.action_x_estate_property_offer_accept"
                    type="action"
                    icon="fa-check"
                    string="Accept"/>
                <button
                    name="estate_importable.action_x_estate_property_offer_refuse"
                    type="action"
                    icon="fa-times"
                    string="Refuse"
                    />
                <!-- In the buttons can add class:
                class="btn-danger" -->
            </tree>
        </field>
    </record>
    <!-- Form view -->
    <record id="view_real_estate_property_offer_form" model="ir.ui.view">
        <field name="name">x_estate.property.offer.form</field>
        <field name="model">x_estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_price"/>
                        <field name="x_partner_id"/>
                        <field name="x_status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>