<templates xml:space="preserve">
    <t t-name="awesome_clicker.ClickerClientAction">
         <div class="m-2">
            <div>
                Clicks: <ClickerValue/>
                <button class="btn btn-primary ms-1" t-on-click="() => this.clicker.increment(9)">
                    Increment
                </button>
            </div>
            <div t-if="this.clicker.level >= 1" class="ms-1 mt-1">
                <h2> Bots </h2> 
                
