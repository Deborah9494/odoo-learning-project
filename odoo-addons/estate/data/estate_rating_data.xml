<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_rating_request" model="mail.template">
        <field name="name">Property Rating Request</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="subject">How was your experience with {{ object.name }}?</field>
        <field name="email_from">{{ object.salesperson_id.email or user.email }}</field>
        <field name="partner_to">{{ object.buyer_id.id }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div>
                <p>
                    Hello <t t-out="object.buyer_id.name or ''"/>,
                </p>
                <p>
                    Thank you for choosing us for
                    <strong>
                        <t t-out="object.name or ''"/>
                    </strong>.
                </p>
                <p>How satisfied are you with your experience?</p>
                <ul>
                    <li>
                        <a t-att-href="'/rate/%s/5' % object._rating_get_access_token()">
                            Very satisfied
                        </a>
                    </li>
                    <li>
                        <a t-att-href="'/rate/%s/3' % object._rating_get_access_token()">
                            Neutral
                        </a>
                    </li>
                    <li>
                        <a t-att-href="'/rate/%s/1' % object._rating_get_access_token()">
                            Very dissatisfied
                        </a>
                    </li>
                </ul>
                <p>Thank you for your feedback!</p>
            </div>
        </field>
    </record>
</odoo>