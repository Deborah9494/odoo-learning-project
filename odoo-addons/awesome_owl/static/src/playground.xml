<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.playground">
        <div class="p-3 border">
            <h1>Hello world</h1>

            <div class="mt-2 p-2 border">
                <Counter onChange.bind="incrementSum"/>
                <Counter onChange.bind="incrementSum"/>
                <div>
                    The sum is: <t t-esc="sum.value"/>
                </div>
            </div>

            <div class="mt-2 p-2 border">
                <Card 
                    title="'First card'" 
                    content="'Hello from the first card'"/>
                <Card 
                    title="'Second card'" 
                    content="'Hello from the second card'"/>
                <Card
                    title="'Normal string'"
                    content="this.normalText"/>
                <Card
                    title="'Markuped string'"
                    content="this.htmlText"/>
            </div>

            <h2>Todo List</h2>
            <TodoList />

        </div>
    </t>
</templates>
