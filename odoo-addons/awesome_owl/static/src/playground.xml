<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.playground">
        <div class="p-3 border">
            <h1 class="mt-3">Hello world</h1>

            <div class="mt-2 p-2 border">
                <Counter onChange.bind="incrementSum"/>
                <Counter onChange.bind="incrementSum"/>
                <div>
                    The sum is: <t t-esc="sum.value"/>
                </div>
            </div>

            <div class="mt-2 p-2 border">
                <Card title="'card 1'">
                    content of card 1
                </Card>
                <Card title="'card 2'">
                    <Counter />
                </Card>
            </div>

            <h2 class="mt-3">Todo List</h2>
            <TodoList />

        </div>
    </t>
</templates>
