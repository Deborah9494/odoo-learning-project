<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="todo_management.NumberCard">

        <div
            class="o_todo_card"
            t-on-click="() => props.onClick(props.domain)"
        >
            <div class="o_todo_card_body">
                <div class="o_todo_card_title">
                    <t t-esc="props.title"/>
                </div>

                <div t-att-class="'o_todo_card_value ' + props.className">
                    <t t-esc="props.value"/>
                </div>
            </div>
        </div>

    </t>
</templates>