<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="todo_management.ProjectDashboard">
        <Layout display="display" className="'o_todo_dashboard h-100'">

            <div class="o_todo_dashboard_content">

                <div class="o_todo_dashboard_header">
                    <h2>Project Dashboard</h2>
                    <p>Overview of your tasks by project</p>
                </div>

                <div class="o_todo_dashboard_cards">
                    <TodoDashboardItem size="2">
                        <ChartCard
                            title="'Tasks by project'"
                            type="'bar'"
                            data="data"
                        />
                    </TodoDashboardItem>
                </div>

            </div>

        </Layout>
    </t>

</templates>