<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="todo_list_view_tree" model="ir.ui.view">
        <field name="name">todo.list.tree</field>
        <field name="model">todo.list</field>

        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="user_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="todo_list_view_form" model="ir.ui.view">
        <field name="name">todo.list.form</field>
        <field name="model">todo.list</field>

        <field name="arch" type="xml">
            <form string="Todo List">

                <sheet>

                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <field name="description"/>
                        <field name="user_id"/>
                        <field name="active"/>
                    </group>

                    <notebook>
                    <page string="Tasks">
                        <field name="item_ids">
                        <kanban>
                        <templates>
                        <t t-name="kanban-box">
                            <div class="o_todo_task_kanban_card">
                                <div class="o_todo_task_header">
                                    <t t-if="record.status.raw_value == 'completed'">
                                        <button
                                            name="action_toggle_status"
                                            type="object"
                                            class="btn btn-link p-0 o_todo_task_check"
                                            icon="fa-check-square-o"
                                            title="Mark as pending"
                                        />
                                    </t>
                                    <t t-else="">
                                        <button
                                            name="action_toggle_status"
                                            type="object"
                                            class="btn btn-link p-0 o_todo_task_check"
                                            icon="fa-square-o"
                                            title="Mark as completed"
                                        />
                                    </t>
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>

                                <div class="o_todo_task_details">

                                    <div>
                                        <span class="text-muted">Due:</span>
                                        <field name="due_date"/>
                                    </div>

                                    <div>
                                        <span class="text-muted">Priority:</span>
                                        <field name="priority"/>
                                    </div>

                                </div>

                            </div>
                        </t>
                        </templates>
                        </kanban>
                        </field>
                    </page>

                    <page string="Tasks List">
                        <field name="item_ids"> 
                            <tree editable="bottom"> 
                                <field name="status"/> 
                                <field name="name"/> 
                                <field name="due_date"/> 
                                <field name="priority"/> 
                                <field name="description"/> 
                            </tree> 
                        </field>
                    </page>

                    </notebook>

                </sheet>
            </form>
        </field>

    </record>

    <record id="todo_list_view_search" model="ir.ui.view">
        <field name="name">todo.list.search</field>
        <field name="model">todo.list</field>

        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>

                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
            </search>
        </field>
    </record>

    <record id="todo_list_action" model="ir.actions.act_window">
        <field name="name">Todo Lists</field>
        <field name="res_model">todo.list</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- When this action is executed, don't open a model view. Give control to a frontend component identified by this tag -->
    <record id="todo_dashboard_action" model="ir.actions.client">
        <field name="name">Todo Dashboard</field>
        <field name="tag">todo_dashboard</field>
    </record>

    <record id="todo_project_dashboard_action" model="ir.actions.client">
        <field name="name">Project Dashboard</field>
        <field name="tag">todo_project_dashboard</field>
    </record>

    <menuitem
        id="todo_menu_root"
        name="Todo"
    />

    <menuitem
        id="todo_project_dashboard_menu"
        name="Projects Dashboard"
        parent="todo_menu_root"
        action="todo_project_dashboard_action"
    />

    <menuitem
        id="todo_dashboard_menu"
        name="Tasks Dashboard"
        parent="todo_menu_root"
        action="todo_dashboard_action"
    />

    <menuitem
        id="todo_list_menu"
        name="Projects"
        parent="todo_menu_root"
        action="todo_list_action"
    />
    
    <menuitem
        id="todo_users_menu"
        name="Users"
        parent="todo_menu_root"
        action="base.action_res_users"
    />

    

</odoo>