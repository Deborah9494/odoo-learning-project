<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="todo_item_view_kanban" model="ir.ui.view">
        <field name="name">todo.item.kanban</field>
        <field name="model">todo.item</field>
        <field name="arch" type="xml">
            <kanban 
                default_group_by="status" 
                records_draggable="true"
                group_create="false">
                <field name="name"/>
                <field name="list_id"/>
                <field name="priority"/>
                <field name="due_date"/>
                <field name="description"/>
                <field name="status"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            
                            <div>
                                <strong>
                                    <field name="name"/>
                                </strong>
                            </div>

                            <div>
                                Project:
                                <field name="list_id"/>
                            </div>

                            <div>
                                Priority:

                                <t t-if="record.priority.raw_value == 'low'">
                                    <span class="text-success">Low</span>
                                </t>

                                <t t-elif="record.priority.raw_value == 'medium'">
                                    <span class="text-warning">Medium</span>
                                </t>

                                <t t-else="">
                                    <span class="text-danger">High</span>
                                </t>
                            </div>

                            <div t-if="record.due_date.raw_value">
                                Due Date:
                                <field name="due_date"/>
                            </div>

                            <div t-else="">
                                No due date
                            </div>

                            <div>
                                <field name="description"/>
                            </div>
                            
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="todo_item_view_tree" model="ir.ui.view">
        <field name="name">todo.item.tree</field>
        <field name="model">todo.item</field>

        <field name="arch" type="xml">
            <tree editable="bottom"
                decoration-muted="status == 'completed'"
            >
                <field name="name"/>
                <field name="list_id"/>
                <field name="priority"
                    decoration-success="priority == 'low'"
                    decoration-warning="priority == 'medium'"
                    decoration-danger="priority == 'high'"/> 
                <field name="due_date"/> 
                <field name="description"/> 
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="todo_item_view_form" model="ir.ui.view">

        <field name="name">todo.item.form</field>
        <field name="model">todo.item</field>
        <field name="arch" type="xml">
            <form string="Item">
                <sheet>
                    <group>
                        <field name="list_id"/>
                        <field name="name"/>
                        <field name="priority"/> 
                        <field name="due_date"/> 
                        <field name="description"/> 
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="todo_item_action" model="ir.actions.act_window">
        <field name="name">Todo Items (Tasks)</field>
        <field name="res_model">todo.item</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <menuitem
        id="todo_item_menu"
        name="Tasks"
        parent="todo_menu_root"
        action="todo_item_action"
    />

</odoo>