<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="todo_item_view_tree" model="ir.ui.view">
        <field name="name">todo.item.tree</field>
        <field name="model">todo.item</field>

        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="list_id"/>
                <field name="completed"/>
            </tree>
        </field>
    </record>

    <record id="todo_item_view_form" model="ir.ui.view">

        <field name="name">todo.item.form</field>
        <field name="model">todo.item</field>
        <field name="arch" type="xml">
            <form string="Item">
                <sheet>
                    <group>
                        <field name="list_id"/>
                        <field name="name"/>
                        <field name="completed"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>